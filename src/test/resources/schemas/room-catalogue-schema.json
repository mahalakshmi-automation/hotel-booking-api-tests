{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "rooms"
  ],
  "properties": {
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "roomid",
          "roomName",
          "type",
          "roomPrice",
          "features",
          "accessible",
          "image",
          "description"
        ],
        "properties": {
          "roomid": {
            "type": "integer",
            "minimum": 1
          },
          "roomName": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "roomPrice": {
            "type": "number",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accessible": {
            "type": "boolean"
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
